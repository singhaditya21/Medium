{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singhaditya21.github.io/Medium/medium/publications.schema.json",
  "title": "Medium publication registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mediumProfile",
    "verifiedAt",
    "verificationMethod",
    "stories"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "mediumProfile": {"type": "string", "format": "uri", "pattern": "^https://medium\\.com/@"},
    "verifiedAt": {"type": "string", "format": "date"},
    "verificationMethod": {"const": "signed_in_medium_published_stories"},
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["storySlug", "status", "mediumUrl"],
        "properties": {
          "storySlug": {"type": "string", "minLength": 1},
          "status": {"enum": ["published", "not_published"]},
          "mediumUrl": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "format": "uri", "pattern": "^https://medium\\.com/"}
            ]
          }
        }
      }
    }
  }
}
