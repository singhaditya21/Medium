{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singhaditya21.github.io/Medium/medium/release.schema.json",
  "title": "Medium draft release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storySlug",
    "operation",
    "topics",
    "canonicalUrl",
    "publication",
    "subscriberEmail",
    "paywall",
    "scheduleAt",
    "humanReviewRequired",
    "requiresFinalConfirmation",
    "allowUnattendedPublish"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "storySlug": {"type": "string", "minLength": 1},
    "operation": {"const": "import_to_private_draft"},
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "canonicalUrl": {"type": "string", "format": "uri", "pattern": "^https://singhaditya21\\.github\\.io/Medium/articles/"},
    "publication": {"type": ["string", "null"]},
    "subscriberEmail": {"const": false},
    "paywall": {"const": false},
    "scheduleAt": {"type": "null"},
    "humanReviewRequired": {"const": true},
    "requiresFinalConfirmation": {"const": true},
    "allowUnattendedPublish": {"const": false}
  }
}
