{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singhaditya21.github.io/Medium/engagement/queue.schema.json",
  "title": "Curated Medium engagement queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "maxBatchSize", "policy", "candidates"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "updatedAt": {"type": "string", "format": "date-time"},
    "maxBatchSize": {"type": "integer", "minimum": 1, "maximum": 5},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresExactActionTimeConfirmation", "allowUnattendedPosting", "allowBulkEngagement"],
      "properties": {
        "requiresExactActionTimeConfirmation": {"const": true},
        "allowUnattendedPosting": {"const": false},
        "allowBulkEngagement": {"const": false}
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "object"}
    }
  }
}
